# 编译产物
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试与覆盖率
*.test
*.out

# 依赖目录（使用 go modules 时无需提交）
/vendor/

# 本地构建缓存（受限环境下将 GOCACHE/GOTMPDIR 指向工作区时产生）
/.gocache/
/.gotmp/

# 运行日志
*.log

# 本地环境变量（可能包含数据库密码）
.env
.env.*
!.env.example

# 本地配置文件（可能包含数据库密码）
/configs/config.yaml

# 数据库设计与建表文件
/database/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
